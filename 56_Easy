class Solution {
    public int[][] merge(int[][] intervals) {

        int n = intervals.length;
        
        for (int i = 0; i < n; i++) {
            for (int j = i + 1; j < n; j++) {

                if (intervals[i][0] > intervals[j][0]) {
                    int[] temp = intervals[i];
                    intervals[i] = intervals[j];
                    intervals[j] = temp;
                }
            }
        }

        int[][] ans = new int[n][2];
        int k = 0;

        ans[k] = intervals[0];

        for (int i = 1; i < n; i++) {

            if (intervals[i][0] <= ans[k][1]) {

                if (intervals[i][1] > ans[k][1]) {
                    ans[k][1] = intervals[i][1];
                }

            } else {
                k++;
                ans[k] = intervals[i];
            }
        }

        int[][] result = new int[k + 1][2];

        for (int i = 0; i <= k; i++) {
            result[i] = ans[i];
        }

        return result;
    }
}
